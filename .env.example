# memory-engine 配置样例：复制为 .env 或直接导出环境变量（未列出的项均有内置默认值）

# 数据根目录（默认 ~/hermes-data）
MEMORY_ENGINE_HOME=
# 引擎目录（默认 <MEMORY_ENGINE_HOME>/memory-engine）
MEMORY_ENGINE_DIR=
# 服务监听
MEMORY_ENGINE_HOST=127.0.0.1
MEMORY_ENGINE_PORT=8766
# PostgreSQL 连接（专用实例默认 DSN）
MEMORY_ENGINE_PG_DSN=postgresql://memengine@127.0.0.1:5433/memengine?sslmode=disable
# 嵌入模型目录（默认 <MEMORY_ENGINE_DIR>/models/qwen3-embedding-0.6b）
MEMORY_ENGINE_MODEL_DIR=
MEMORY_ENGINE_EMBED_DEVICE=cuda
# 备份（本盘默认 <MEMORY_ENGINE_DIR>/backups；外置建议异盘挂载路径）
MEMORY_ENGINE_BACKUP_LOCAL=
MEMORY_ENGINE_BACKUP_EXT=
MEMORY_ENGINE_WAL_ARCHIVE_DIR=

# —— 评测（eval/，可选）——
# 旧版记忆库 sqlite（l1_records 表，必填才能跑评测）
MEMORY_EVAL_LEGACY_DB=
# 会话库 sqlite（交叉验证，可选）
MEMORY_EVAL_STATE_DB=
# 基线对照服务地址（可选）
MEMORY_EVAL_BASELINE_URL=http://127.0.0.1:8420/v3/atomic/search
# 基线服务鉴权键（也可放本文件，run_compare.py 会读取）
LLM_GATEWAY_API_KEY=
